{
  "openapi": "3.1.0",
  "info": {
    "title": "Iran Building Regulations — Phase Zero",
    "version": "0.1.0",
    "description": "Local development scaffold. No AI, no certified regulation corpus, no applicability engine."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765"
    }
  ],
  "paths": {
    "/api/v1/sources": {
      "get": {
        "summary": "فهرست metadata منابع؛ catalog_only بدون DB",
        "responses": {
          "200": {
            "description": "JSON result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResponse"
                }
              }
            }
          },
          "503": {
            "description": "JSON result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/topics": {
      "get": {
        "summary": "موضوع‌های تأییدشده؛ بدون استنتاج پروژه",
        "responses": {
          "200": {
            "description": "JSON result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResponse"
                }
              }
            }
          },
          "503": {
            "description": "JSON result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/search": {
      "get": {
        "summary": "جست‌وجوی literal در بندهای تأییدشده",
        "responses": {
          "200": {
            "description": "JSON result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResponse"
                }
              }
            }
          },
          "503": {
            "description": "JSON result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "JSON result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200
            }
          }
        ]
      }
    },
    "/health": {
      "get": {
        "summary": "Process and configured DB health",
        "responses": {
          "200": {
            "description": "Health JSON"
          },
          "503": {
            "description": "JSON result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "summary": "Process and configured DB health",
        "responses": {
          "200": {
            "description": "Health JSON"
          },
          "503": {
            "description": "JSON result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/project-preview": {
      "post": {
        "summary": "اعتبارسنجی و بازتاب مشخصات بدون ذخیره یا تطبیق ضوابط",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Project"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResponse"
                }
              }
            }
          },
          "400": {
            "description": "JSON result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "JSON result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "JSON result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "ListResponse": {
        "type": "object",
        "required": [
          "mode",
          "items"
        ],
        "properties": {
          "mode": {
            "enum": [
              "database",
              "catalog_only"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "applicability_status": {
            "type": "string"
          }
        }
      },
      "Project": {
        "type": "object",
        "required": [
          "city",
          "use",
          "structure",
          "stage",
          "area",
          "floors",
          "basements"
        ],
        "properties": {
          "city": {
            "type": "string",
            "enum": [
              "تهران",
              "مشهد",
              "اصفهان",
              "شیراز",
              "تبریز",
              "کرج",
              "قم",
              "اهواز",
              "رشت",
              "کرمان",
              "یزد",
              "سایر شهرها / نیازمند تکمیل"
            ]
          },
          "use": {
            "type": "string",
            "enum": [
              "مسکونی",
              "اداری",
              "تجاری",
              "آموزشی",
              "درمانی",
              "صنعتی",
              "مختلط"
            ]
          },
          "structure": {
            "type": "string",
            "enum": [
              "بتن‌آرمه",
              "فولادی",
              "بنایی",
              "سایر / نامشخص"
            ]
          },
          "stage": {
            "type": "string",
            "enum": [
              "مطالعات اولیه",
              "طراحی",
              "اجرا",
              "بهره‌برداری"
            ]
          },
          "area": {
            "type": "number",
            "minimum": 1,
            "maximum": 1000000
          },
          "floors": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "basements": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          }
        }
      }
    }
  }
}

