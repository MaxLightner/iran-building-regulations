# Load these into the process environment; .env is not auto-loaded.
HOST=127.0.0.1
PORT=8765
# Empty = explicit catalog-only demo, no operational data.
DATABASE_URL=
# PostgreSQL example (set your own password, never commit it):
# DATABASE_URL=postgresql://regulations:YOUR_PASSWORD@localhost:5432/regulations
# Outside Git; never served by the web application:
# SOURCE_CACHE_DIR=C:/path/to/private/regulations-pdfs

