{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Temporary project profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "city",
    "use",
    "structure",
    "area",
    "floors",
    "basements",
    "stage"
  ],
  "properties": {
    "city": {
      "type": "string"
    },
    "use": {
      "type": "string"
    },
    "structure": {
      "type": "string"
    },
    "area": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "floors": {
      "type": "integer",
      "minimum": 1
    },
    "basements": {
      "type": "integer",
      "minimum": 0
    },
    "stage": {
      "type": "string"
    },
    "height": {
      "type": [
        "number",
        "null"
      ]
    },
    "permit_date": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
