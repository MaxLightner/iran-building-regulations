{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Regulation record (v1)",
  "type": "object",
  "required": [
    "id",
    "document_id",
    "edition_id",
    "kind",
    "locator",
    "title",
    "original_text",
    "summary",
    "topic",
    "tags",
    "aliases",
    "key_factors",
    "applicability",
    "references",
    "source",
    "version",
    "review"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "edition_id": {
      "type": "string"
    },
    "section_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "enum": [
        "clause",
        "table",
        "note",
        "figure",
        "appendix"
      ]
    },
    "locator": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "original_text": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "key_factors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "value",
          "evidence_locator"
        ]
      }
    },
    "applicability": {
      "type": "object",
      "required": [
        "status",
        "conditions"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_evaluated",
            "pending_review",
            "reviewed"
          ]
        },
        "conditions": {
          "type": "array"
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "authority",
        "official_page_url",
        "official_pdf_url",
        "sha256",
        "pdf_page",
        "printed_page",
        "publication_rights"
      ]
    },
    "version": {
      "type": "object",
      "required": [
        "edition_label",
        "published_date",
        "effective_date",
        "effective_evidence",
        "status",
        "last_checked"
      ]
    },
    "review": {
      "type": "object",
      "required": [
        "status",
        "reviewer",
        "reviewed_at"
      ]
    }
  },
  "additionalProperties": false
}
